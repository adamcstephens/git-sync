<Layouts.app flash={@flash} current_operator={@current_operator}>
  <.header>
    Mappings
    <:subtitle>Source repositories mirrored onto destinations.</:subtitle>
  </.header>

  <.table id="mappings" rows={@mappings}>
    <:col :let={mapping} label="Source">
      {mapping.source_repo} on {mapping.source_connection.base_url}
    </:col>
    <:col :let={mapping} label="Destination">
      {mapping.destination_repo} on {mapping.destination_connection.base_url}
    </:col>
    <:col :let={mapping} label="Every">{mapping.interval_seconds}s</:col>
    <:col :let={mapping} label="State">{(mapping.enabled && "on") || "off"}</:col>
    <:action :let={mapping}>
      <.link href={~p"/mappings/#{mapping}"}>Runs</.link>
    </:action>
  </.table>

  <.header>Add a mapping</.header>

  <.form for={@form} id="mapping-form" action={~p"/mappings"}>
    <.input
      field={@form[:source_connection_id]}
      type="select"
      label="Source forge"
      options={@connection_options}
      prompt="Choose a forge"
      data-bind="source_connection_id"
      data-on:change={"@get('#{~p"/mappings/repos"}')"}
    />
    <.repo_field
      id="source-repo-field"
      field={@form[:source_repo]}
      label="Source repository"
      repos={@source_repos}
    />
    <.input
      field={@form[:destination_connection_id]}
      type="select"
      label="Destination forge"
      options={@connection_options}
      prompt="Choose a forge"
      data-bind="destination_connection_id"
      data-on:change={"@get('#{~p"/mappings/repos"}')"}
    />
    <.repo_field
      id="destination-repo-field"
      field={@form[:destination_repo]}
      label="Destination repository"
      repos={@destination_repos}
    />
    <.input field={@form[:interval_seconds]} type="number" label="Interval in seconds" />

    <.button id="add-mapping" type="submit">Add mapping</.button>
  </.form>
</Layouts.app>
